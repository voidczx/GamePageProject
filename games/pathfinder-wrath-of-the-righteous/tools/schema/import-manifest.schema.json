{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://field-manuals.example/schemas/wotr/import-manifest.schema.json",
  "title": "Pathfinder: Wrath of the Righteous snapshot import manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "snapshotId",
    "gameId",
    "gameVersion",
    "contentVersion",
    "localization",
    "sources"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "snapshotId": { "type": "string", "minLength": 1 },
    "gameId": { "const": "pathfinder-wrath-of-the-righteous" },
    "gameVersion": { "type": "string", "minLength": 1 },
    "contentVersion": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "localization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primaryLocale", "fallbackLocales"],
      "properties": {
        "primaryLocale": { "type": "string", "minLength": 1 },
        "fallbackLocales": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "path", "version"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["blueprints", "localization"] },
          "path": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "priority": { "type": "integer", "default": 0 }
        }
      }
    }
  }
}
